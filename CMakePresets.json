{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with symbols, no optimization",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build with LTO",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "appimage",
      "displayName": "AppImage",
      "description": "Release build configured for AppDir installation (prefix=/usr)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-appimage",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "/usr"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",    "configurePreset": "debug"    },
    { "name": "release",  "configurePreset": "release"  },
    { "name": "appimage", "configurePreset": "appimage" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
